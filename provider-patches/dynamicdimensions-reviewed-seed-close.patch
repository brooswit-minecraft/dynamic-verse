+    }
+
+    @Test
+    void productionOrchestratorReplacementUsesResultPolicyAndNeverReportsReady() {
+        class Source { }
+        Source admitted = new Source();
+        Source replacement = new Source();
+        List<String> terminal = new ArrayList<>();
+        QuiesceAndCloseOrchestrator.Outcome outcome = new QuiesceAndCloseOrchestrator<Source>().execute(admitted, new QuiesceAndCloseOrchestrator.Operations<>() {
+            @Override public Source current() { return replacement; }
