+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class QuiesceAndCloseQueueTest {
+    @Test
+    void detachedBatchDefersReentrantTicketsAndPreventsSameKeyReplay() {
+        QuiesceAndCloseQueue<String> queue = new QuiesceAndCloseQueue<>();
+        List<String> executed = new ArrayList<>();
+        assertTrue(queue.admit("a", "a"));
+        queue.drain(ticket -> {
+            executed.add(ticket);
+            assertFalse(queue.admit("a", "again"));
+            assertTrue(queue.admit("b", "b"));
+            queue.release(ticket);
+        });
+        assertEquals(List.of("a"), executed);
+        queue.drain(ticket -> { executed.add(ticket); queue.release(ticket); });
+        assertEquals(List.of("a", "b"), executed);
+    }
+
+    @Test
+    void twoTicketsDrainOnceEvenWhenOneCallbackThrows() {
+        QuiesceAndCloseQueue<String> queue = new QuiesceAndCloseQueue<>();
+        List<String> executed = new ArrayList<>();
+        queue.admit("a", "a");
+        queue.admit("b", "b");
+        queue.drain(ticket -> {
+            executed.add(ticket);
+            queue.release(ticket);
+            if (ticket.equals("a")) throw new IllegalStateException("callback failure is isolated by production bridge");
+        });
+        assertEquals(List.of("a", "b"), executed);
+        queue.drain(ticket -> { executed.add(ticket); queue.release(ticket); });
+        assertEquals(List.of("a", "b"), executed);
+    }
+}
