+package dev.galacticraft.dynamicdimensions.impl.internal;
+
+import dev.galacticraft.dynamicdimensions.api.lifecycle.QuiesceAndCloseSourceReadiness;
+
+import java.util.function.Function;
+
+/** Production result policy: only the admitted, still-active instance can be READY. */
+public final class QuiesceAndCloseResultPolicy<S, R> {
+    public R create(S admitted, S active, boolean quarantined, Function<QuiesceAndCloseSourceReadiness, R> factory) {
+        QuiesceAndCloseSourceReadiness readiness = quarantined
+                ? QuiesceAndCloseSourceReadiness.QUARANTINED
+                : admitted != null && active == admitted ? QuiesceAndCloseSourceReadiness.READY
+                : QuiesceAndCloseSourceReadiness.UNLOADED;
+        return factory.apply(readiness);
+    }
+}
