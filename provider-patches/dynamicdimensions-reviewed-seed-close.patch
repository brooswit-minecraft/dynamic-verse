+package dev.galacticraft.dynamicdimensions.impl.internal;
+
+import dev.galacticraft.dynamicdimensions.api.lifecycle.QuiesceAndCloseStatus;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class QuiesceAndCloseStateMachineTest {
+    @Test
+    void successfulTerminalRequiresSaveThenClose() {
+        QuiesceAndCloseStateMachine state = new QuiesceAndCloseStateMachine();
+        state.playersRelocated();
+        state.saved();
+        state.closed();
+        assertDoesNotThrow(() -> state.terminal(QuiesceAndCloseStatus.SAVED_AND_CLOSED));
+    }
+
+    @Test
+    void saveFailureCannotFollowClose() {
+        QuiesceAndCloseStateMachine state = new QuiesceAndCloseStateMachine();
+        state.playersRelocated();
+        state.saved();
+        state.closed();
+        assertThrows(IllegalStateException.class, () -> state.terminal(QuiesceAndCloseStatus.FAILED_SAVE));
+    }
+
+    @Test
+    void terminalCanOnlyBeEmittedOnce() {
+        QuiesceAndCloseStateMachine state = new QuiesceAndCloseStateMachine();
+        state.terminal(QuiesceAndCloseStatus.FAILED_CLOSE);
+        assertThrows(IllegalStateException.class, () -> state.terminal(QuiesceAndCloseStatus.FAILED_CLOSE));
+    }
+}
