@@ -0,0 +1,54 @@
+package dev.galacticraft.dynamicdimensions.impl.internal;
+
+import dev.galacticraft.dynamicdimensions.api.lifecycle.QuiesceAndCloseFailureStage;
+import dev.galacticraft.dynamicdimensions.api.lifecycle.QuiesceAndCloseStatus;
+
+/**
+ * Production lifecycle policy shared by the Mixin bridge and its controlled
+ * doubles. Operations are deliberately limited to the concrete bridge steps.
+ */
+public final class QuiesceAndCloseOrchestrator<S> {
+    public record Outcome(QuiesceAndCloseStatus status, QuiesceAndCloseFailureStage failureStage, Throwable cause) { }
+
+    public interface Operations<S> {
+        S current();
+        void relocatePlayers();
+        QuiesceAndCloseSaveStep.Operations<S> saveOperations();
+        void quarantine(S source);
+        QuiesceAndCloseCloseStep.Closer<S> closer();
+        void cleanup(S source);
+    }
+
+    public Outcome execute(S admitted, Operations<S> operations) {
+        QuiesceAndCloseStateMachine state = new QuiesceAndCloseStateMachine();
+        S active = operations.current();
+        if (admitted == null || active == null) return this.terminal(state, QuiesceAndCloseStatus.FAILED_CLOSE,
+                QuiesceAndCloseFailureStage.SOURCE_NOT_LOADED, new IllegalStateException("Source was not loaded"));
+        if (active != admitted) return this.terminal(state, QuiesceAndCloseStatus.FAILED_CLOSE,
+                QuiesceAndCloseFailureStage.REPLACED_SOURCE, new IllegalStateException("Source was replaced"));
+        try {
+            operations.relocatePlayers();
+            state.playersRelocated();
+        } catch (RuntimeException e) {
+            return this.terminal(state, QuiesceAndCloseStatus.FAILED_SAVE, QuiesceAndCloseFailureStage.PLAYER_RELOCATION, e);
+        }
+        RuntimeException saveFailure = new QuiesceAndCloseSaveStep<S>().save(admitted, operations.saveOperations());
+        if (saveFailure != null) return this.terminal(state, QuiesceAndCloseStatus.FAILED_SAVE, QuiesceAndCloseFailureStage.SAVE, saveFailure);
+        state.saved();
+        QuiesceAndCloseCloseStep.Decision close = new QuiesceAndCloseCloseStep<S>().close(admitted, operations::current,
+                operations::quarantine, operations.closer());
+        if (!close.closed()) return this.terminal(state, QuiesceAndCloseStatus.FAILED_CLOSE, close.failureStage(), close.cause());
+        state.closed();
+        QuiesceAndCloseCleanupStep.Decision cleanup = new QuiesceAndCloseCleanupStep().run(() -> operations.cleanup(admitted),
+                () -> operations.quarantine(admitted));
+        if (!cleanup.completed()) return this.terminal(state, QuiesceAndCloseStatus.FAILED_CLOSE,
+                QuiesceAndCloseFailureStage.CLEANUP, cleanup.failure());
+        return this.terminal(state, QuiesceAndCloseStatus.SAVED_AND_CLOSED, null, null);
+    }
+
+    private Outcome terminal(QuiesceAndCloseStateMachine state, QuiesceAndCloseStatus status,
+                             QuiesceAndCloseFailureStage failureStage, Throwable cause) {
+        state.terminal(status);
+        return new Outcome(status, failureStage, cause);
+    }
+}
