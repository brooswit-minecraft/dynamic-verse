diff --git a/neoforge/scripts/runSeedGameTestWithReceipt.sh b/neoforge/scripts/runSeedGameTestWithReceipt.sh
new file mode 100644
index 0000000..6310a6f
--- /dev/null
+++ b/neoforge/scripts/runSeedGameTestWithReceipt.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+# Deliberately not executed during preparation. A separately assigned runtime
+# invocation must run this absolute wrapper with /bin/bash.
+set -uo pipefail
+
+root="${SEED_GAMETEST_ROOT:-/tmp/dynamicdimensions-composite/neoforge/run/seedGameTest-normal-aba}"
+script="${SEED_GAMETEST_SCRIPT:-/tmp/dynamicdimensions-composite/neoforge/build/moddev/runSeedGameTest.sh}"
+receipt_root="${SEED_GAMETEST_RECEIPT_ROOT:-/tmp/dynamicdimensions-composite/neoforge/seedGameTest-normal-aba-receipts}"
+log="$receipt_root/seedGameTest.full.log"
+generated_exit="$receipt_root/seedGameTest.generated-exit"
+tee_exit="$receipt_root/seedGameTest.tee-exit"
+wrapper_exit="$receipt_root/seedGameTest.wrapper-exit"
+
+refuse() {
+  printf '%s\n' "$1" >&2
+  exit "$2"
+}
+
+# Refuse before creating any receipt directory: a refusal must not overwrite
+# previous evidence or make a failed preflight look like a completed run.
+if [ -L "$root" ] || [ ! -d "$root" ]; then
+  refuse "seed GameTest root is missing or a link: $root" 64
+fi
+if ! cd -- "$root"; then
+  refuse "cannot cd to seed GameTest root: $root" 65
+fi
+if [ "$(pwd -P)" != "$root" ]; then
+  refuse "seed GameTest root canonical path mismatch: $(pwd -P)" 66
+fi
+if [ -n "$(find . -mindepth 1 -maxdepth 1 -print -quit)" ]; then
+  refuse "seed GameTest root is not empty: $root" 67
+fi
+if [ -e "$receipt_root" ] || [ -L "$receipt_root" ]; then
+  refuse "seed GameTest receipt directory already exists: $receipt_root" 68
+fi
+if ! mkdir -- "$receipt_root"; then
+  refuse "cannot claim seed GameTest receipt directory: $receipt_root" 69
+fi
+
+set +e
+/bin/bash -e -- "$script" 2>&1 | tee "$log"
+pipeline_status=("${PIPESTATUS[@]}")
+set -e
+
+status=0
+if [ "${pipeline_status[0]}" -ne 0 ]; then
+  status="${pipeline_status[0]}"
+elif [ "${pipeline_status[1]}" -ne 0 ]; then
+  status="${pipeline_status[1]}"
+fi
+
+receipt_failed=0
+printf '%s\n' "${pipeline_status[0]}" > "$generated_exit" || receipt_failed=1
+printf '%s\n' "${pipeline_status[1]}" > "$tee_exit" || receipt_failed=1
+if [ "$receipt_failed" -ne 0 ]; then
+  status=70
+fi
+printf '%s\n' "$status" > "$wrapper_exit" || exit 71
+exit "$status"
