+            @Override public void quarantine(Source source) { throw new AssertionError(); }
+            @Override public QuiesceAndCloseCloseStep.Closer<Source> closer() { return source -> { throw new AssertionError(); }; }
+            @Override public void cleanup(Source source) { throw new AssertionError(); }
+        });
+        assertEquals(QuiesceAndCloseStatus.FAILED_CLOSE, outcome.status());
+        assertEquals(QuiesceAndCloseFailureStage.REPLACED_SOURCE, outcome.failureStage());
+        new QuiesceAndCloseTerminals<String>().emit(12, new QuiesceAndCloseResultPolicy<Source, String>().create(admitted, replacement, false,
+                readiness -> outcome.status() + "/" + outcome.failureStage() + "/" + readiness), terminal::add, ignored -> { throw new AssertionError(); });
+        assertEquals(List.of("FAILED_CLOSE/REPLACED_SOURCE/UNLOADED"), terminal);
+    }
