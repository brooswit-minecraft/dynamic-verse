+package dev.galacticraft.dynamicdimensions.impl.internal;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.function.Consumer;
+
+/** Persists terminal outcome before isolating arbitrary listener failure. */
+public final class QuiesceAndCloseTerminals<T> {
+    private final Map<Long, T> results = new HashMap<>();
+
+    public boolean emit(long generation, T result, Consumer<T> callback, Consumer<RuntimeException> callbackFailure) {
+        if (this.results.putIfAbsent(generation, result) != null) return false;
+        try { callback.accept(result); } catch (RuntimeException e) { callbackFailure.accept(e); }
+        return true;
+    }
+}
