@@ -0,0 +1,23 @@
+package dev.galacticraft.dynamicdimensions.impl.internal;
+
+/** Production forced-save boundary: always restores the caller's no-save flag. */
+public final class QuiesceAndCloseSaveStep<S> {
+    public interface Operations<S> {
+        boolean noSave(S source);
+        void noSave(S source, boolean value);
+        void save(S source);
+    }
+
+    public RuntimeException save(S source, Operations<S> operations) {
+        boolean previous = operations.noSave(source);
+        try {
+            operations.noSave(source, false);
+            operations.save(source);
+            return null;
+        } catch (RuntimeException e) {
+            return e;
+        } finally {
+            operations.noSave(source, previous);
+        }
+    }
+}
