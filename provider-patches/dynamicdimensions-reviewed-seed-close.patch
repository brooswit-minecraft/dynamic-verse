@@ -0,0 +1,50 @@
+package dev.galacticraft.dynamicdimensions.impl;
+
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.Map;
+import java.util.OptionalLong;
+
+/**
+ * Identity-scoped, generation-checked ownership table used by the explicit
+ * dimension-seed bridge. It intentionally has no Minecraft lifecycle calls so
+ * its replacement and stale-cleanup rules can be verified locally.
+ */
+final class SeedOwnershipTable<S, K> {
+    private final Map<S, Map<K, Entry>> owners = new IdentityHashMap<>();
+    private long nextGeneration;
+
+    Lease<S, K> claim(S owner, K key, long seed) {
+        Map<K, Entry> entries = this.owners.computeIfAbsent(owner, ignored -> new HashMap<>());
+        if (entries.containsKey(key)) return null;
+        Entry entry = new Entry(seed, ++this.nextGeneration);
+        entries.put(key, entry);
+        return new Lease<>(owner, key, entry.seed, entry.generation);
+    }
+
+    OptionalLong seed(S owner, K key) {
+        Map<K, Entry> entries = this.owners.get(owner);
+        Entry entry = entries == null ? null : entries.get(key);
+        return entry == null ? OptionalLong.empty() : OptionalLong.of(entry.seed);
+    }
+
+    boolean release(Lease<S, K> lease) {
+        Map<K, Entry> entries = this.owners.get(lease.owner());
+        Entry current = entries == null ? null : entries.get(lease.key());
+        if (current == null || current.generation != lease.generation()) return false;
+        entries.remove(lease.key());
+        if (entries.isEmpty()) this.owners.remove(lease.owner());
+        return true;
+    }
+
+    boolean matches(Lease<S, K> lease) {
+        Map<K, Entry> entries = this.owners.get(lease.owner());
+        Entry current = entries == null ? null : entries.get(lease.key());
+        return current != null && current.generation == lease.generation();
+    }
+
+    void dispose(S owner) { this.owners.remove(owner); }
+
+    record Lease<S, K>(S owner, K key, long seed, long generation) { }
+    private record Entry(long seed, long generation) { }
+}
