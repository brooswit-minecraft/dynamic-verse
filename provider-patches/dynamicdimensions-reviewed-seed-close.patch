@@ -0,0 +1,40 @@
+package dev.galacticraft.dynamicdimensions.impl;
+
+import java.util.OptionalLong;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.Level;
+
+/** Version-pinned adapter around the production identity/generation state machine. */
+public final class DimensionSeedOwnership {
+    private static final SeedOwnershipState<MinecraftServer, ResourceKey<Level>, ServerLevel> STATE = new SeedOwnershipState<>();
+    private DimensionSeedOwnership() { }
+    public static synchronized Lease claim(MinecraftServer server, ResourceKey<Level> key, long seed) {
+        SeedOwnershipTable.Lease<MinecraftServer, ResourceKey<Level>> lease = STATE.claim(server, key, seed);
+        return lease == null ? null : new Lease(lease);
+    }
+    public static Construction enterConstruction(Lease lease) { return new Construction(STATE.enter(lease.delegate)); }
+    /** Pinned post-super ServerLevel.<init> hook binds only the exact receiver for this construction scope. */
+    public static synchronized boolean attachConstructingReceiver(ServerLevel level, MinecraftServer server, ResourceKey<Level> key) {
+        return STATE.attachConstructingReceiver(level, server, key);
+    }
+    public static synchronized OptionalLong seedFor(ServerLevel level) { return STATE.seedFor(level); }
+    /** RegistryImpl's separate biome argument is allowed only before the exact receiver attaches. */
+    public static synchronized OptionalLong seedForConstruction(MinecraftServer server, ResourceKey<Level> key) { return STATE.seedForConstruction(server, key); }
+    public static synchronized boolean retire(ServerLevel level, Lease expected) { return STATE.retire(level, expected.delegate); }
+    /** Exact-lease abort clears any bound receiver for that lease but cannot affect a replacement. */
+    public static synchronized boolean abort(Lease expected) { return STATE.abort(expected.delegate); }
+    public static synchronized void disposeServer(MinecraftServer server) { STATE.dispose(server); }
+    public static final class Construction implements AutoCloseable {
+        private final SeedOwnershipState.Construction<MinecraftServer, ResourceKey<Level>, ServerLevel> token;
+        private Construction(SeedOwnershipState.Construction<MinecraftServer, ResourceKey<Level>, ServerLevel> token) { this.token = token; }
+        @Override public void close() { STATE.close(token); }
+    }
+    public static final class Lease {
+        private final SeedOwnershipTable.Lease<MinecraftServer, ResourceKey<Level>> delegate;
+        private Lease(SeedOwnershipTable.Lease<MinecraftServer, ResourceKey<Level>> delegate) { this.delegate = delegate; }
+        public long seed() { return delegate.seed(); }
+        public long generation() { return delegate.generation(); }
+    }
+}
