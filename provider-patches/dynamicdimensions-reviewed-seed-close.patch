+package dev.galacticraft.dynamicdimensions.impl.internal;
+
+/** Production cleanup boundary that turns post-close failures into a terminal failure. */
+public final class QuiesceAndCloseCleanupStep {
+    public record Decision(boolean completed, RuntimeException failure) { }
+
+    public Decision run(Runnable cleanup, Runnable quarantine) {
+        try {
+            cleanup.run();
+            return new Decision(true, null);
+        } catch (RuntimeException e) {
+            quarantine.run();
+            return new Decision(false, e);
+        }
+    }
+}
