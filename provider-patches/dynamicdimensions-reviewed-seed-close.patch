@@ -0,0 +1,76 @@
+package dev.galacticraft.dynamicdimensions.impl;
+
+import java.util.IdentityHashMap;
+import java.util.Map;
+import java.util.OptionalLong;
+
+/**
+ * Production seed-ownership state machine. Construction uses one explicit
+ * receiver token; all later reads and retirement use only that bound identity.
+ */
+final class SeedOwnershipState<S, K, L> {
+    private final SeedOwnershipTable<S, K> leases = new SeedOwnershipTable<>();
+    private final Map<L, SeedOwnershipTable.Lease<S, K>> bound = new IdentityHashMap<>();
+    private final ThreadLocal<Construction<S, K, L>> constructing = new ThreadLocal<>();
+
+    SeedOwnershipTable.Lease<S, K> claim(S owner, K key, long seed) { return leases.claim(owner, key, seed); }
+    Construction<S, K, L> enter(SeedOwnershipTable.Lease<S, K> lease) {
+        if (constructing.get() != null) throw new IllegalStateException("Nested explicit-seed construction");
+        Construction<S, K, L> token = new Construction<>(lease);
+        constructing.set(token);
+        return token;
+    }
+    boolean attachConstructingReceiver(L receiver, S owner, K key) {
+        Construction<S, K, L> token = constructing.get();
+        if (token == null || token.receiver != null || token.lease.owner() != owner || !token.lease.key().equals(key)
+                || !leases.matches(token.lease)) return false;
+        token.receiver = receiver;
+        bound.put(receiver, token.lease);
+        return true;
+    }
+    OptionalLong seedFor(L receiver) {
+        SeedOwnershipTable.Lease<S, K> lease = bound.get(receiver);
+        if (lease != null) return OptionalLong.of(lease.seed());
+        Construction<S, K, L> token = constructing.get();
+        return token != null && token.active && token.receiver == receiver && leases.matches(token.lease)
+                ? OptionalLong.of(token.lease.seed()) : OptionalLong.empty();
+    }
+    OptionalLong seedForConstruction(S owner, K key) {
+        Construction<S, K, L> token = constructing.get();
+        return token != null && token.active && token.receiver == null && leases.matches(token.lease)
+                && token.lease.owner() == owner && token.lease.key().equals(key)
+                ? OptionalLong.of(token.lease.seed()) : OptionalLong.empty();
+    }
+    boolean retire(L receiver, SeedOwnershipTable.Lease<S, K> expected) {
+        if (bound.get(receiver) != expected) return false;
+        bound.remove(receiver);
+        invalidate(expected);
+        return leases.release(expected);
+    }
+    boolean abort(SeedOwnershipTable.Lease<S, K> expected) {
+        bound.entrySet().removeIf(entry -> entry.getValue() == expected);
+        invalidate(expected);
+        return leases.release(expected);
+    }
+    void dispose(S owner) {
+        bound.entrySet().removeIf(entry -> entry.getValue().owner() == owner);
+        Construction<S, K, L> token = constructing.get();
+        if (token != null && token.lease.owner() == owner) { token.active = false; token.receiver = null; }
+        leases.dispose(owner);
+    }
+    private void invalidate(SeedOwnershipTable.Lease<S, K> lease) {
+        Construction<S, K, L> token = constructing.get();
+        if (token != null && token.lease == lease) { token.active = false; token.receiver = null; }
+    }
+    static final class Construction<S, K, L> implements AutoCloseable {
+        private final SeedOwnershipTable.Lease<S, K> lease;
+        private L receiver;
+        private boolean active = true;
+        private Construction(SeedOwnershipTable.Lease<S, K> lease) { this.lease = lease; }
+        @Override public void close() { }
+    }
+    void close(Construction<S, K, L> token) {
+        if (constructing.get() != token) throw new IllegalStateException("Construction scope changed");
+        constructing.remove();
+    }
+}
