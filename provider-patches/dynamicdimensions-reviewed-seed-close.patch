+class QuiesceAndCloseBridgeTest {
+    @Test
+    void forcedSavePrecedesCloseAndRestoresNoSaveOnSuccessAndFailure() {
+        class Source { boolean noSave = true; final List<String> calls = new ArrayList<>(); }
+        QuiesceAndCloseSaveStep<Source> step = new QuiesceAndCloseSaveStep<>();
+        Source success = new Source();
+        assertEquals(null, step.save(success, new QuiesceAndCloseSaveStep.Operations<>() {
+            @Override public boolean noSave(Source source) { return source.noSave; }
+            @Override public void noSave(Source source, boolean value) { source.noSave = value; }
+            @Override public void save(Source source) { source.calls.add("save:" + source.noSave); }
+        }));
+        assertEquals(List.of("save:false"), success.calls);
+        assertTrue(success.noSave);
+        Source failure = new Source();
+        RuntimeException error = step.save(failure, new QuiesceAndCloseSaveStep.Operations<>() {
+            @Override public boolean noSave(Source source) { return source.noSave; }
+            @Override public void noSave(Source source, boolean value) { source.noSave = value; }
+            @Override public void save(Source source) { throw new IllegalStateException("save"); }
+        });
+        assertEquals("save", error.getMessage());
+        assertTrue(failure.noSave);
+    }
+    @Test
+    void ioAndUncheckedCloseQuarantineThenAllowNextTicket() {
+        for (Exception failure : List.of(new IOException("io"), new IllegalStateException("unchecked"))) {
+            Object source = new Object();
+            AtomicReference<Object> active = new AtomicReference<>(source);
+            List<Object> quarantined = new ArrayList<>();
+            QuiesceAndCloseCloseStep.Decision decision = new QuiesceAndCloseCloseStep<Object>().close(source, active::get, value -> { quarantined.add(value); active.compareAndSet(value, null); }, value -> {
+                if (failure instanceof IOException io) throw io;
+                throw (RuntimeException) failure;
+            });
+            assertFalse(decision.closed());
+            assertEquals(QuiesceAndCloseFailureStage.CLOSE, decision.failureStage());
+            assertEquals(QuiesceAndCloseSourceReadiness.QUARANTINED, decision.readiness());
+            assertEquals(List.of(source), quarantined);
+            assertEquals(null, active.get());
+        }
+    }
+
+    @Test
+    void replacementAndInitiallyUnloadedNeverReportAdmittedSourceReady() {
+        Object admitted = new Object();
+        Object replacement = new Object();
+        QuiesceAndCloseCloseStep<Object> step = new QuiesceAndCloseCloseStep<>();
+        QuiesceAndCloseCloseStep.Decision replaced = step.close(admitted, () -> replacement, ignored -> { throw new AssertionError(); }, ignored -> { throw new AssertionError(); });
+        assertEquals(QuiesceAndCloseFailureStage.REPLACED_SOURCE, replaced.failureStage());
+        assertEquals(QuiesceAndCloseSourceReadiness.UNLOADED, replaced.readiness());
+        QuiesceAndCloseCloseStep.Decision unloaded = step.close(null, () -> replacement, ignored -> { throw new AssertionError(); }, ignored -> { throw new AssertionError(); });
+        assertEquals(QuiesceAndCloseFailureStage.SOURCE_NOT_LOADED, unloaded.failureStage());
+        assertEquals(QuiesceAndCloseSourceReadiness.UNLOADED, unloaded.readiness());
+    }
+
+    @Test
