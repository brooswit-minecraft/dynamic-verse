+package dev.galacticraft.dynamicdimensions.impl.internal;
+
+import dev.galacticraft.dynamicdimensions.api.lifecycle.QuiesceAndCloseFailureStage;
+import dev.galacticraft.dynamicdimensions.api.lifecycle.QuiesceAndCloseSourceReadiness;
+
+import java.io.IOException;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+/** Production close boundary; injectable only through its narrow operations port. */
+public final class QuiesceAndCloseCloseStep<S> {
+    public record Decision(boolean closed, QuiesceAndCloseSourceReadiness readiness, QuiesceAndCloseFailureStage failureStage, Throwable cause) { }
+
+    @FunctionalInterface public interface Closer<S> { void close(S source) throws IOException; }
+
+    public Decision close(S admitted, Supplier<S> current, Consumer<S> quarantine, Closer<S> closer) {
+        S active = current.get();
+        if (admitted == null || active == null) return new Decision(false, QuiesceAndCloseSourceReadiness.UNLOADED, QuiesceAndCloseFailureStage.SOURCE_NOT_LOADED, new IllegalStateException("Source was not loaded"));
+        if (active != admitted) return new Decision(false, QuiesceAndCloseSourceReadiness.UNLOADED, QuiesceAndCloseFailureStage.REPLACED_SOURCE, new IllegalStateException("Source was replaced"));
+        try {
+            closer.close(admitted);
+            return new Decision(true, QuiesceAndCloseSourceReadiness.UNLOADED, null, null);
+        } catch (IOException | RuntimeException e) {
+            quarantine.accept(admitted);
+            return new Decision(false, QuiesceAndCloseSourceReadiness.QUARANTINED, QuiesceAndCloseFailureStage.CLOSE, e);
+        }
+    }
+}
