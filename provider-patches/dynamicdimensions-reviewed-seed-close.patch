@@ -0,0 +1,39 @@
+package dev.galacticraft.dynamicdimensions.impl.internal;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.function.Consumer;
+
+/** Production tick-queue seam: detaches each batch before arbitrary callbacks run. */
+public final class QuiesceAndCloseQueue<T> {
+    private final List<T> pending = new ArrayList<>();
+    private final Set<Object> lockedKeys = new HashSet<>();
+
+    public boolean admit(Object key, T ticket) {
+        if (!this.lockedKeys.add(key)) return false;
+        this.pending.add(ticket);
+        return true;
+    }
+
+    public boolean isLocked(Object key) {
+        return this.lockedKeys.contains(key);
+    }
+
+    public void release(Object key) {
+        this.lockedKeys.remove(key);
+    }
+
+    public void drain(Consumer<T> executor) {
+        List<T> batch = new ArrayList<>(this.pending);
+        this.pending.clear();
+        for (T ticket : batch) {
+            try {
+                executor.accept(ticket);
+            } catch (RuntimeException ignored) {
+                // The concrete bridge records its terminal failure; never replay this ticket.
+            }
+        }
+    }
+}
