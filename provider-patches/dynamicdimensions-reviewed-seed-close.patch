+package dev.galacticraft.dynamicdimensions.impl;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.Test;
+
+class SeedOwnershipTableTest {
+    @Test
+    void distinctOwnersAndKeysKeepSeedsIndependentAndRepeatable() {
+        SeedOwnershipTable<Object, String> table = new SeedOwnershipTable<>();
+        Object firstServer = new Object();
+        Object secondServer = new Object();
+        SeedOwnershipTable.Lease<Object, String> first = table.claim(firstServer, "dynamicverse:alpha", 17L);
+        SeedOwnershipTable.Lease<Object, String> second = table.claim(firstServer, "dynamicverse:beta", 29L);
+        SeedOwnershipTable.Lease<Object, String> repeat = table.claim(secondServer, "dynamicverse:alpha", 17L);
+
+        assertEquals(17L, table.seed(firstServer, "dynamicverse:alpha").orElseThrow());
+        assertEquals(29L, table.seed(firstServer, "dynamicverse:beta").orElseThrow());
+        assertEquals(17L, table.seed(secondServer, "dynamicverse:alpha").orElseThrow());
+        assertTrue(table.release(first));
+        assertEquals(29L, table.seed(firstServer, "dynamicverse:beta").orElseThrow());
+        assertTrue(table.release(second));
+        assertTrue(table.release(repeat));
+    }
+
+    @Test
+    void conflictIsRefusedAndStaleCleanupCannotEraseReplacementGeneration() {
+        SeedOwnershipTable<Object, String> table = new SeedOwnershipTable<>();
+        Object server = new Object();
+        SeedOwnershipTable.Lease<Object, String> first = table.claim(server, "dynamicverse:alpha", 17L);
+        assertNull(table.claim(server, "dynamicverse:alpha", 29L));
+        assertTrue(table.release(first));
+        SeedOwnershipTable.Lease<Object, String> replacement = table.claim(server, "dynamicverse:alpha", 29L);
+        assertFalse(table.release(first));
+        assertEquals(29L, table.seed(server, "dynamicverse:alpha").orElseThrow());
+        assertTrue(table.release(replacement));
+        assertTrue(table.seed(server, "dynamicverse:alpha").isEmpty());
+    }
+}
