@@ -0,0 +1,64 @@
+package dev.galacticraft.dynamicdimensions.impl;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.Test;
+
+/** Exercises the exact production ownership helper with ordinary identity tokens. */
+class SeedOwnershipStateTest {
+    @Test void oldReceiverCannotReadReplacementDuringExactConstructionAndStaleRetireCannotClearIt() {
+        SeedOwnershipState<Object, String, Object> state = new SeedOwnershipState<>();
+        Object server = new Object(); Object old = new Object(); Object replacement = new Object();
+        SeedOwnershipTable.Lease<Object, String> first = state.claim(server, "dynamicverse:alpha", 11L);
+        SeedOwnershipState.Construction<Object, String, Object> firstToken = state.enter(first);
+        assertTrue(state.attachConstructingReceiver(old, server, "dynamicverse:alpha")); state.close(firstToken);
+        assertTrue(state.retire(old, first));
+        SeedOwnershipTable.Lease<Object, String> second = state.claim(server, "dynamicverse:alpha", 22L);
+        SeedOwnershipState.Construction<Object, String, Object> secondToken = state.enter(second);
+        assertTrue(state.seedFor(old).isEmpty());
+        assertTrue(state.attachConstructingReceiver(replacement, server, "dynamicverse:alpha"));
+        assertEquals(22L, state.seedFor(replacement).orElseThrow());
+        assertFalse(state.retire(old, first));
+        state.close(secondToken);
+    }
+
+    @Test void unrelatedOrNestedLegacyConstructionCannotReceiveScopedSeedAndAbortRemovesOnlyExactBinding() {
+        SeedOwnershipState<Object, String, Object> state = new SeedOwnershipState<>();
+        Object server = new Object(); Object target = new Object(); Object unrelated = new Object();
+        SeedOwnershipTable.Lease<Object, String> first = state.claim(server, "dynamicverse:alpha", 31L);
+        SeedOwnershipState.Construction<Object, String, Object> token = state.enter(first);
+        assertTrue(state.seedForConstruction(server, "dynamicverse:alpha").isPresent());
+        assertTrue(state.seedForConstruction(server, "dynamicverse:beta").isEmpty());
+        assertFalse(state.attachConstructingReceiver(unrelated, server, "dynamicverse:beta"));
+        assertTrue(state.attachConstructingReceiver(target, server, "dynamicverse:alpha"));
+        assertTrue(state.seedForConstruction(server, "dynamicverse:alpha").isEmpty(), "biome fallback ends after exact receiver attachment");
+        assertTrue(state.abort(first));
+        assertTrue(state.seedFor(target).isEmpty());
+        assertTrue(state.seedForConstruction(server, "dynamicverse:alpha").isEmpty(), "abort invalidates an active construction token");
+        state.close(token);
+        SeedOwnershipTable.Lease<Object, String> replacement = state.claim(server, "dynamicverse:alpha", 32L);
+        assertFalse(state.abort(first), "stale abort cannot erase replacement");
+        state.dispose(server);
+        assertTrue(state.seedFor(target).isEmpty());
+        assertTrue(state.abort(replacement) == false, "server disposal already removed replacement claim");
+    }
+
+    @Test void retireAndDisposalInvalidateActiveTokens() {
+        SeedOwnershipState<Object, String, Object> state = new SeedOwnershipState<>();
+        Object server = new Object(); Object first = new Object(); Object replacement = new Object();
+        SeedOwnershipTable.Lease<Object, String> lease = state.claim(server, "dynamicverse:alpha", 1L);
+        SeedOwnershipState.Construction<Object, String, Object> token = state.enter(lease);
+        assertTrue(state.attachConstructingReceiver(first, server, "dynamicverse:alpha"));
+        assertTrue(state.retire(first, lease));
+        assertTrue(state.seedFor(first).isEmpty());
+        state.close(token);
+        SeedOwnershipTable.Lease<Object, String> newer = state.claim(server, "dynamicverse:alpha", 2L);
+        SeedOwnershipState.Construction<Object, String, Object> newerToken = state.enter(newer);
+        assertTrue(state.attachConstructingReceiver(replacement, server, "dynamicverse:alpha"));
+        state.dispose(server);
+        assertTrue(state.seedFor(replacement).isEmpty());
+        state.close(newerToken);
+    }
+}
