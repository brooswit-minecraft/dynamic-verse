+package dev.galacticraft.dynamicdimensions.impl.internal;
+
+import dev.galacticraft.dynamicdimensions.api.lifecycle.QuiesceAndCloseStatus;
+
+/** Enforces the only valid terminal ordering for the provider adaptation. */
+public final class QuiesceAndCloseStateMachine {
+    private Phase phase = Phase.ADMITTED;
+    private boolean terminal;
+
+    public void playersRelocated() {
+        this.require(Phase.ADMITTED);
+        this.phase = Phase.PLAYERS_RELOCATED;
+    }
+
+    public void saved() {
+        this.require(Phase.PLAYERS_RELOCATED);
+        this.phase = Phase.SAVED;
+    }
+
+    public void closed() {
+        this.require(Phase.SAVED);
+        this.phase = Phase.CLOSED;
+    }
+
+    public void terminal(QuiesceAndCloseStatus status) {
+        if (this.terminal) throw new IllegalStateException("Terminal result already emitted");
+        if (status == QuiesceAndCloseStatus.SAVED_AND_CLOSED) this.require(Phase.CLOSED);
+        if (status == QuiesceAndCloseStatus.FAILED_SAVE && this.phase == Phase.CLOSED) {
+            throw new IllegalStateException("Save failure cannot follow close");
+        }
+        this.terminal = true;
+    }
+
+    private void require(Phase expected) {
+        if (this.phase != expected) throw new IllegalStateException("Expected " + expected + " but was " + this.phase);
+    }
+
+    private enum Phase {
+        ADMITTED,
+        PLAYERS_RELOCATED,
+        SAVED,
+        CLOSED
+    }
+}
