--- /dev/null
+++ b/common/src/main/java/dev/galacticraft/dynamicdimensions/impl/mixin/ServerLevelMixin.java
@@ -0,0 +1,55 @@
+package dev.galacticraft.dynamicdimensions.impl.mixin;
+
+import dev.galacticraft.dynamicdimensions.impl.DimensionSeedOwnership;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.progress.ChunkProgressListener;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.world.RandomSequences;
+import net.minecraft.world.level.CustomSpawner;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.dimension.LevelStem;
+import net.minecraft.world.level.storage.LevelStorageSource;
+import net.minecraft.world.level.storage.ServerLevelData;
+import net.minecraft.world.level.levelgen.WorldOptions;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.Redirect;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+import java.util.List;
+import java.util.concurrent.Executor;
+
+/**
+ * Pinned against NeoForge 21.1.148 ServerLevel.<init>: WorldOptions.seed() is
+ * consumed directly by StructureCheck/RandomSequences before normal gameplay
+ * starts. The registry installs DimensionSeedOwnership before `new ServerLevel`.
+ */
+@Mixin(ServerLevel.class)
+abstract class ServerLevelMixin {
+    /**
+     * Exact pinned 1.21.1 constructor descriptor, attached after Level.<init>
+     * and before later seed-dependent ServerLevel work. The scope admits one receiver only.
+     */
+    @Inject(method = "<init>(Lnet/minecraft/server/MinecraftServer;Ljava/util/concurrent/Executor;Lnet/minecraft/world/level/storage/LevelStorageSource$LevelStorageAccess;Lnet/minecraft/world/level/storage/ServerLevelData;Lnet/minecraft/resources/ResourceKey;Lnet/minecraft/world/level/dimension/LevelStem;Lnet/minecraft/server/level/progress/ChunkProgressListener;ZJLjava/util/List;ZLnet/minecraft/world/RandomSequences;)V", at = @At(value = "INVOKE", target = "Lnet/minecraft/world/level/Level;<init>(Lnet/minecraft/world/level/storage/WritableLevelData;Lnet/minecraft/resources/ResourceKey;Lnet/minecraft/core/RegistryAccess;Lnet/minecraft/core/Holder;Ljava/util/function/Supplier;ZZJI)V", shift = At.Shift.AFTER))
+    private void dynamicdimensions$attachConstructingReceiver(MinecraftServer server, Executor executor,
+            LevelStorageSource.LevelStorageAccess storage, ServerLevelData data, ResourceKey<Level> key, LevelStem stem,
+            ChunkProgressListener progress, boolean debug, long biomeSeed, List<CustomSpawner> spawners, boolean tickTime,
+            RandomSequences randomSequences, CallbackInfo callback) {
+        DimensionSeedOwnership.attachConstructingReceiver((ServerLevel) (Object) this, server, key);
+    }
+    @Inject(method = "getSeed()J", at = @At("HEAD"), cancellable = true)
+    private void dynamicdimensions$explicitSeed(CallbackInfoReturnable<Long> callback) {
+        ServerLevel level = (ServerLevel) (Object) this;
+        DimensionSeedOwnership.seedFor(level).ifPresent(callback::setReturnValue);
+    }
+
+    /** Exact 1.21.1 target: Lnet/minecraft/world/level/levelgen/WorldOptions;seed()J in ServerLevel.<init>. */
+    @Redirect(method = "<init>", at = @At(value = "INVOKE", target = "Lnet/minecraft/world/level/levelgen/WorldOptions;seed()J"))
+    private long dynamicdimensions$constructorSeed(WorldOptions options) {
+        ServerLevel level = (ServerLevel) (Object) this;
+        return DimensionSeedOwnership.seedFor(level).orElseGet(options::seed);
+    }
+
+}
